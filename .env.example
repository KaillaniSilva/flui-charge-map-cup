# Copie este arquivo para .env e preencha com a sua chave.
# A chave do Google Maps so e necessaria para o modo de mapa nativo (USE_GOOGLE_MAPS = true em src/config.js).
# Para Android, a chave tambem deve ser colada em app.json > expo.android.config.googleMaps.apiKey
GOOGLE_MAPS_API_KEY=cole_sua_chave_aqui
